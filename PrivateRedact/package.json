{
  "name": "privateredact",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side PDF redaction: removes text, images and metadata under redaction boxes entirely in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/himanshu-codes290/PrivateRedact.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "analyze": "cross-env ANALYZE=1 vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "cd .. && husky PrivateRedact/.husky || true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.41.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml}": "prettier --write"
  }
}
